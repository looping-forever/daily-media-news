{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "gemini": {
      "npm": "@ai-sdk/google",
      "name": "Google AI Studio (Gemini free tier)",
      "options": {
        "apiKey": "{env:GEMINI_API_KEY}"
      },
      "models": {
        "gemini-3.5-flash-lite": {
          "name": "Gemini 3.5 Flash Lite",
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        },
        "gemini-3.1-flash-lite": {
          "name": "Gemini 3.1 Flash Lite",
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        }
      }
    },
    "gemini-key2": {
      "npm": "@ai-sdk/google",
      "name": "Google AI Studio (Gemini free tier, second project)",
      "options": {
        "apiKey": "{env:GEMINI_API_KEY_2}"
      },
      "models": {
        "gemini-3.5-flash-lite": {
          "name": "Gemini 3.5 Flash Lite",
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        },
        "gemini-3.1-flash-lite": {
          "name": "Gemini 3.1 Flash Lite",
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        }
      }
    },
    "groq": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Groq (free tier)",
      "options": {
        "baseURL": "https://api.groq.com/openai/v1",
        "apiKey": "{env:GROQ_API_KEY}"
      },
      "models": {
        "allam-2-7b": {
          "name": "Allam 2 7B",
          "limit": {
            "context": 131072,
            "output": 4096
          }
        }
      }
    },
    "groq-key2": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Groq (free tier, second account)",
      "options": {
        "baseURL": "https://api.groq.com/openai/v1",
        "apiKey": "{env:GROQ_API_KEY_2}"
      },
      "models": {
        "allam-2-7b": {
          "name": "Allam 2 7B",
          "limit": {
            "context": 131072,
            "output": 4096
          }
        }
      }
    }
  }
}
