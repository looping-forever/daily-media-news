{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "gemini": {
      "npm": "@ai-sdk/google",
      "name": "Google AI Studio (Gemini free tier)",
      "options": {
        "apiKey": "{env:GEMINI_API_KEY}"
      },
      "models": {
        "gemini-3.5-flash-lite": {
          "name": "Gemini 3.5 Flash Lite",
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        },
        "gemini-3.1-flash-lite": {
          "name": "Gemini 3.1 Flash Lite",
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        }
      }
    }
  }
}
