docs/digests-test/

# Dynamic model selection runtime memory (2026-10-13).
#   model_cache.json -- the last live `opencode models` listing (6h TTL).
#                       Committing it would freeze today's catalogue into the
#                       repository, which is precisely the hardcoded-ladder
#                       brittleness this replaced. Still ignored.
#   model_health.json -- per-model success/failure counters and cooldowns.
#                       COMMITTED from the breaking workflow: it is the
#                       ordering memory the NEXT run reorders around, and while
#                       it was ignored that promise was false in CI. See the
#                       "Commit breaking state" step in breaking-monitor.yml.
# A missing model_cache.json is a cold cache, and a cold cache re-discovers
# live on the next run; a missing model_health.json just means nothing is known
# yet, so the ladder starts from its configured order.
state/model_cache.json

# U6. The ntfy payload a prebuild writes so digest-prebuild.yml's seal job can
# build the artifact. It is a hand-over between two steps in one run, never a
# repository fact: the "Clean transient state files" step removes it and the
# state commit stages a fixed path list that never named it. Listed here anyway,
# because a run killed between the write and the cleanup would otherwise leave
# a build's notification payload sitting in the working tree.
state/ntfy_payload.json

# Test / dry-run artifacts (never commit)
state/email.txt
pytest_output.txt

# The ladder probe's WORKING DIRECTORY (--ladder-probe). The probe walks the
# real ladder, so it writes pending/health/cooldown/attempts -- and it does that
# HERE, never in state/, so a diagnostic can neither promote a rung in the
# committed health memory nor record a shared-pool refusal that would silence
# the real monitor. The RESULT is state/ladder_probe.json, deliberately NOT
# matched by this pattern: it is committed, because an artifact expires in 7
# days and the answer must outlive it.
state/ladder_probe/

# The academic monitor's state: it carries the owner's ROLL NUMBER, and this
# repository is public. It is never committed by design -- academic-result.yml
# restores it from the KV key `academic:state` and writes it back there, and the
# only other copy is the run's 7-day artifact. Listed here so a local run cannot
# put it into the working tree as an untracked file that `git add -A` picks up.
state/academic_state.json

# The academic monitor's live payload hand-over (2026-10-27). It carries the
# roll number too, so it is written by the script and never committed; the
# workflow removes it before each run and the delivery steps read it from the
# working tree. Listed here because an untracked copy left behind by a killed
# run is exactly what `git add -A` would sweep into a public commit.
state/academic_live_payload.jsonl

# Wrangler local cache (contains Cloudflare account id)
deploy/.wrangler/

# Wrangler's local secrets file. `.dev.vars` holds real secret values in
# plaintext for `wrangler dev`; it must never be committed or uploaded.
deploy/.dev.vars
deploy/.dev.vars.*

# The RENDERED deploy config, written by scripts/deploy-worker.ps1 from the
# committed template plus the real KV namespace id out of the environment. It
# holds that id, so it is regenerated on every deploy and never committed; the
# committed template keeps a placeholder.
deploy/wrangler.local.toml

# Root-level wrangler cache. `deploy/.wrangler/` above covers the nested one,
# but wrangler also writes `<repo-root>/.wrangler/` when a Pages/Workers command
# is run from the repository root, and that copy is NOT covered by the nested
# pattern -- it showed up as untracked in `git status` on 2026-09-30, holding a
# Cloudflare account id and miniflare cache/kv sqlite files. This is the ONE
# tracked-file/ignore-consistency fix: nothing under it is ever meant to be
# committed, and an unlisted cache directory is how a credential gets committed
# by accident. (The tracked-but-ignored `state/*.json` files are deliberately
# NOT "fixed" here: they are a separate report-only finding, because
# un-tracking them is a `git rm`, which is out of scope for an ignore change.)
.wrangler/

# MyAnimeList personal watch-list exports. These are DOWNLOADED ARTEFACTS from
# MyAnimeList.net and contain a personal account profile (<myinfo>: user_id,
# user_name) plus a per-title status history. They are inputs to
# scripts/mal_status.py, but they are personal data and must never be published.
# The function degrades gracefully when they are absent (an empty status map, no
# crash), so the MAL status filter is simply inert in the public copy. The
# private working copy keeps its own exports.
config/mal/*.xml.gz